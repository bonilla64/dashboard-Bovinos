# Copie este archivo como .env y cambie los valores marcados. El archivo .env NUNCA se sube al repositorio.

# --- Base de datos (la crea docker compose) ---
POSTGRES_USER=ganadero
POSTGRES_PASSWORD=CAMBIE_ESTA_CLAVE
POSTGRES_DB=simulador_ganadero

# Solo si corre la API SIN Docker (npm run dev), con PostgreSQL + PostGIS instalado en su equipo:
DATABASE_URL=postgresql://ganadero:CAMBIE_ESTA_CLAVE@localhost:5432/simulador_ganadero
# Base aparte para las pruebas automáticas (npm test). Se BORRA en cada ejecución:
DATABASE_URL_PRUEBAS=postgresql://ganadero:CAMBIE_ESTA_CLAVE@localhost:5432/simulador_ganadero_pruebas

# --- Autenticación ---
# Mínimo 32 caracteres aleatorios. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA_SEGUNDOS=28800

# Contraseña de las cuentas de demostración (mínimo 10 caracteres). Déjela vacía para no cargar datos de demostración.
CONTRASENA_DEMO=

# --- API ---
PORT=3000
# Direcciones desde las que el tablero puede llamar a la API, separadas por coma.
# Un * vale por un subdominio: https://*.app.github.dev sirve para GitHub Codespaces.
CORS_ORIGEN=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=info
# Proxies delante de la API (1 en Render). 0 = ninguno.
TRUST_PROXY=0

# --- Puertos publicados por docker compose ---
API_PUERTO=3000
WEB_PUERTO=8080

# --- Precios (fuente: Fedegán) ---
# Días después de los cuales un precio sale con advertencia, y después de los cuales ya no se usa.
PRECIO_DIAS_ADVERTENCIA=7
PRECIO_DIAS_MAXIMO=30
# Enlace CSV de la hoja de precios publicada (ver docs/precios/README.md). Vacío = no se sincroniza.
PRECIOS_CSV_URL=

# --- Rutas desde el municipio del lote ---
# Servidor OSRM para medir la ruta por carretera. Vacío = estimación en línea recta × sinuosidad.
OSRM_BASE_URL=https://router.project-osrm.org
