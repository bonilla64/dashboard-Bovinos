# Copie este archivo como .env y llene los valores. El archivo .env NO se sube al repositorio.
# En la Entrega 2 ninguna variable es obligatoria: el prototipo es estático.

# --- API (Entrega 3) ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL + PostGIS (Entrega 3) ---
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/simulador_ganadero

# --- Caché (Entrega 3) ---
REDIS_URL=redis://localhost:6379

# --- Servicios de rutas ---
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_ROUTES_API_KEY=

# --- Autenticación (Entrega 3) ---
JWT_SECRET=
